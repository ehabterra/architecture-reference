---
// A dismissible, low-key notice shown under the nav. Tells readers the pages are
// distilled (with AI help) from real sources so an error can slip through, and
// invites contribution. English is the base; the Arabic overlay comes from the
// `notice.*` keys in `src/i18n/ar.json` via the `data-i18n` swap in ui.js.
// Dismissal persists in localStorage (`dp-notice-dismissed`); the pre-paint
// script in BaseLayout hides it before first paint so it never flashes on reload.
import { REPO_URL } from '../lib/consts';
const ISSUES_URL = `${REPO_URL}/issues`;
---
<aside class="dp-notice" id="dp-notice" role="note">
  <div class="dp-container dp-notice__inner">
    <span class="dp-notice__spark" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="9" />
        <path d="M12 11v5" />
        <path d="M12 8h.01" />
      </svg>
    </span>
    <p class="dp-notice__text">
      <strong data-i18n="notice.title">Good to know —</strong>
      <span data-i18n="notice.body">this reference is a growing, open-source project. Pages are distilled with AI help from 20+ real architecture books, so an error can slip through. Spot something off? Help improve it or open a quick issue.</span>
    </p>
    <span class="dp-notice__actions">
      <a class="dp-notice__cta" href={REPO_URL} target="_blank" rel="noopener" data-i18n="notice.contribute">Contribute</a>
      <a class="dp-notice__cta dp-notice__cta--ghost" href={ISSUES_URL} target="_blank" rel="noopener" data-i18n="notice.report">Report an issue</a>
    </span>
    <button class="dp-notice__close" id="dp-notice-close" type="button" aria-label="Dismiss" title="Dismiss">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>
</aside>
